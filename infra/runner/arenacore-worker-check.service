[Unit]
Description=ArenaCore trusted worker dependency check
After=network-online.target arenacore-supervisor.service
Wants=network-online.target
Requires=arenacore-supervisor.service

[Service]
Type=oneshot
User=arenacore-worker
Group=arenacore-runner
WorkingDirectory=/opt/arenacore/current
EnvironmentFile=/etc/arenacore/worker.env
Environment=NODE_ENV=production
Environment=RUNNER_WORKER_ENABLED=true
Environment=RUNNER_SOCKET_PATH=/run/arenacore/supervisor.sock
ExecStart=/usr/bin/node /opt/arenacore/current/apps/api/dist/executions/worker-main.js --check
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=10.0.0.51/32
MemoryMax=512M
TasksMax=64
LimitNOFILE=1024
