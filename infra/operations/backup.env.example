# Root-owned /etc/arenacore/backup.env (mode 0600).
POSTGRES_CONTAINER=watchtower-postgres-1
BACKUP_DATABASES="arenacore REPLACE_WITH_WATCHTOWER_DATABASE"
BACKUP_DIRECTORY=/var/backups/arenacore
BACKUP_LOCAL_RETENTION_HOURS=24
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_OFFLINE_RECIPIENT
BACKUP_OCI_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
BACKUP_OCI_PREFIX=postgres
