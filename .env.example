NODE_ENV=development
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://arenacore:local-development-only@localhost:5432/arenacore?schema=public
# Job creation stays disabled until queue and isolated execution are ready.
EXECUTIONS_ENABLED=false
MAX_ACTIVE_JOBS_PER_USER=1
# Shared new-job quotas; retries of an existing key do not consume these budgets.
MAX_ACTIVE_JOBS_GLOBAL=1000
EXECUTION_CREATIONS_PER_MINUTE=10
EXECUTION_IP_CREATIONS_PER_MINUTE=60
EXECUTION_GLOBAL_CREATIONS_PER_MINUTE=300
# Canonical base64 of 32 random bytes; required if EXECUTIONS_ENABLED=true.
# Keep this independent of the OIDC key and identical across API replicas.
EXECUTION_RATE_LIMIT_KEY=
QUEUE_TTL_SECONDS=120
JOB_MAINTENANCE_INTERVAL_SECONDS=15
# No development authentication bypass; protected routes require a real session.

# Register this confidential web client with your OIDC provider.
# Callback: ${PUBLIC_ORIGIN}/api/v1/auth/callback (register the actual URL, not this placeholder).
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# A base64-encoded random 32-byte key; keep stable across API instances/restarts.
OIDC_TRANSACTION_KEY=
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_ID_TOKEN_ALG=RS256
SESSION_TTL_SECONDS=28800
AUTH_LOGIN_REQUESTS_PER_MINUTE=20
AUTH_LOGIN_GLOBAL_PER_MINUTE=120
# Explicit proxy IPs/CIDRs only; empty means forwarded IP headers are untrusted.
TRUST_PROXY_CIDRS=

# Stage 5 dispatch and public realtime. Neither starts a code execution backend.
PIPELINE_ENABLED=false
REALTIME_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=arenacore-executions
