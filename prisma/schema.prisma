generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}
enum Difficulty {
  EASY
  MEDIUM
  HARD
}
enum Language {
  java
  python
  javascript
}
enum ExecutionMode {
  RUN
  SUBMIT
}
enum ExecutionState {
  QUEUED
  COMPILING
  RUNNING
  FINISHED
  CANCELLED
  INTERNAL_ERROR
}
enum Verdict {
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  OUTPUT_LIMIT_EXCEEDED
  CANCELLED
  INTERNAL_ERROR
}
enum Visibility {
  PUBLIC
  HIDDEN
}
enum ExecutionFailureCode {
  QUEUE_TIMEOUT
  JOB_FAILURE
  LEASE_EXPIRED
  JOB_TIMEOUT
  CANCELLATION_TIMEOUT
}
enum DiscussionStatus {
  VISIBLE
  HIDDEN
  DELETED
}
enum CompetitionKind {
  CONTEST
  TOURNAMENT
}
model User {
  id           String      @id @default(uuid()) @db.Uuid
  issuer       String
  subject      String
  displayName  String
  username     String      @unique @default(dbgenerated("('user_'::text || replace((gen_random_uuid())::text, '-'::text, ''::text))"))
  bio          String?
  location     String?
  website      String?
  role         Role        @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  executions   Execution[]
  discussionPosts DiscussionPost[]
  discussionLikes DiscussionLike[]
  discussionRateLimit DiscussionRateLimit?
  competitionRegistrations CompetitionRegistration[]
  @@unique([issuer, subject])
}
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  csrfTokenHash String    @db.Char(64)
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  @@index([expiresAt])
  @@index([userId, revokedAt, expiresAt])
}
model Problem {
  id         String           @id @default(uuid()) @db.Uuid
  slug       String           @unique
  currentVersionId String? @unique @db.Uuid
  currentVersion ProblemVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions   ProblemVersion[] @relation("ProblemVersions")
  discussionPosts DiscussionPost[]
  competitionProblems CompetitionProblem[]
  createdAt  DateTime         @default(now())
}

model Competition {
  id            String                    @id @default(uuid()) @db.Uuid
  slug          String                    @unique
  kind          CompetitionKind
  title         String
  description   String
  rulesMarkdown String
  prizeLabel    String?
  startsAt      DateTime
  endsAt        DateTime
  published     Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  rounds        CompetitionRound[]
  registrations CompetitionRegistration[]
  @@index([kind, published, startsAt])
}

model CompetitionRound {
  id            String               @id @default(uuid()) @db.Uuid
  competitionId String               @db.Uuid
  competition   Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  title         String
  ordinal       Int
  startsAt      DateTime
  endsAt        DateTime
  problems      CompetitionProblem[]
  @@unique([competitionId, ordinal])
  @@index([competitionId, startsAt])
}

model CompetitionProblem {
  roundId  String           @db.Uuid
  round    CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  problemId String          @db.Uuid
  problem  Problem          @relation(fields: [problemId], references: [id], onDelete: Restrict)
  ordinal  Int
  points   Int              @default(100)
  @@id([roundId, problemId])
  @@unique([roundId, ordinal])
  @@index([problemId])
}

model CompetitionRegistration {
  competitionId String      @db.Uuid
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())
  @@id([competitionId, userId])
  @@index([userId, joinedAt])
}
model ProblemVersion {
  id                String         @id @default(uuid()) @db.Uuid
  problemId         String         @db.Uuid
  problem           Problem        @relation("ProblemVersions", fields: [problemId], references: [id])
  currentFor        Problem?       @relation("CurrentVersion")
  number            Int
  published         Boolean        @default(false)
  title             String
  difficulty        Difficulty
  tags              String[]
  statementMarkdown String
  constraints       String[]
  timeMs            Int
  memoryKiB         Int
  templates         Json
  comparator        String         @default("EXACT_NEWLINE")
  testCases         TestCase[]
  executions        Execution[]
  createdAt         DateTime       @default(now())
  @@unique([problemId, number])
  @@index([published, problemId])
}
model TestCase {
  id               String         @id @default(uuid()) @db.Uuid
  problemVersionId String         @db.Uuid
  problemVersion   ProblemVersion @relation(fields: [problemVersionId], references: [id])
  ordinal          Int
  visibility       Visibility
  input            String
  expectedOutput   String
  @@unique([problemVersionId, ordinal])
  @@index([problemVersionId, visibility])
}
model Execution {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id])
  problemVersionId String         @db.Uuid
  problemVersion   ProblemVersion @relation(fields: [problemVersionId], references: [id])
  language         Language
  mode             ExecutionMode
  sourceCode       String
  payloadHash      String         @db.Char(64)
  idempotencyKey   String
  state            ExecutionState @default(QUEUED)
  verdict          Verdict?
  attempt          Int            @default(0)
  lastSequence     Int            @default(0)
  leaseToken       String?        @db.Uuid
  leaseExpiresAt   DateTime?
  runtimeImage     String?
  runtimeMs        Int?
  memoryKiB        Int?
  // Public RUN results only. Hidden diagnostics must never enter this column.
  publicResults    Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  finishedAt       DateTime?
  queueExpiresAt   DateTime       @default(dbgenerated("(CURRENT_TIMESTAMP + '00:02:00'::interval)"))
  failureCode      ExecutionFailureCode?
  cancellationRequestedAt DateTime?
  outboxEvents     OutboxEvent[]
  publicEvents     ExecutionEvent[]
  @@unique([userId, idempotencyKey])
  @@index([userId, state])
  @@index([state, createdAt])
  @@index([userId, mode, id])
  @@index([userId, mode, createdAt, id])
  @@index([state, queueExpiresAt, id])
  @@index([state, leaseExpiresAt])
}
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String
  executionId String    @db.Uuid
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  generation Int @default(0)
  dispatchToken String? @db.Uuid
  dispatchExpiresAt DateTime?
  nextDispatchAt DateTime @default(now())
  dispatchAttempts Int @default(0)
  @@index([publishedAt, createdAt])
  @@unique([executionId, kind, generation])
}
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  targetId  String?  @db.Uuid
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model DiscussionPost {
  id        String           @id @default(uuid()) @db.Uuid
  problemId String           @db.Uuid
  problem   Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId  String           @db.Uuid
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?          @db.Uuid
  parent    DiscussionPost?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DiscussionPost[] @relation("DiscussionReplies")
  title     String?
  body      String
  status    DiscussionStatus @default(VISIBLE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  likes     DiscussionLike[]
  @@index([problemId, parentId, status, createdAt, id])
  @@index([parentId, status, createdAt, id])
  @@index([authorId, createdAt])
}

model DiscussionLike {
  postId    String         @db.Uuid
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  @@id([postId, userId])
  @@index([userId, createdAt])
}

model DiscussionRateLimit {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model AuthAttempt {
  stateHash          String   @id @db.Char(64)
  browserTokenHash   String   @db.Char(64)
  encryptedPayload   String
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  @@index([expiresAt])
  @@index([browserTokenHash])
}
model AuthRateLimit {
  key       String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model ExecutionRateLimit {
  key       String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model ExecutionEvent {
  id String @id @default(uuid()) @db.Uuid
  executionId String @db.Uuid
  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  attempt Int
  sequence Int
  kind String
  payload Json
  bytes Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@unique([executionId, attempt, sequence])
  @@index([expiresAt])
}
